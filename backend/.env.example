OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o
# Low-latency defaults for real-time CPU transcription:
# CHUNK_BYTES=1600
# STT_MODEL=tiny
# STT_DEVICE=cuda
# STT_COMPUTE_TYPE=float16
# STT_PARTIAL_WINDOW=2.0
# STT_PARTIAL_INTERVAL=0.25
# STT_FINAL_WINDOW=6.0
# STT_FINAL_INTERVAL=1.2
# STT_FINAL_LAG=0.35
# Optional meter tuning for faster visual responsiveness.
# AUDIO_LEVEL_INTERVAL=0.04
# AUDIO_LEVEL_RMS_REF=0.06
# AUDIO_LEVEL_PEAK_REF=0.22
# Optional: force a specific Pulse/PipeWire monitor source.
# AUDIO_SOURCE=alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__hw_sofhdadsp__sink.monitor
# Optional: force a specific microphone source.
# AUDIO_MIC_SOURCE=alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__hw_sofhdadsp__source
# Optional: choose startup mode (`system` or `mic`).
# AUDIO_MODE=system
# Optional: VAD can suppress low-volume speech from system audio. Default is false.
# STT_VAD_FILTER=false
